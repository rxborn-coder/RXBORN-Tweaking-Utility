@echo off
::===========================================================================
::  Rxborn Tweaking Utility  –  pure CMD / .bat edition
::  Safe, reversible tweaks: restore point, temp clean, animations off,
::  high-performance power plan, disable Delivery Optimisation, etc.
::===========================================================================
setlocal EnableExtensions EnableDelayedExpansion
title Rxborn Tweaking Utility

::-------------- mandatory admin check -------------------------------------
fltmc >nul 2>nul || (
   echo This script must be run as Administrator.
   pause & exit /b 1
)

::-------------- init folders / log ----------------------------------------
set "SCR=%~dp0"
set "TS=%DATE:~10,4%%DATE:~4,2%%DATE:~7,2%-%TIME:~0,2%%TIME:~3,2%%TIME:~6,2%"
set "TS=%TS: =0%"
set "BAK=%SCR%ZeroDelayBackup-%TS%"
md "%BAK%" 2>nul
set "LOG=%BAK%\tweak-log.txt"
>>"%LOG%" echo === Rxborn Tweaking Utility started %DATE% %TIME% ===

::-------------- helper macros ---------------------------------------------
set "LOG=>>\"%BAK%\"\tweak-log.txt echo"
set "PAUSE=pause>nul|set/p =Press any key to continue... "
set "OK=echo [✔] Done"
type nul >"%TEMP%\~nx0_mark"

::===========================================================================
:MENU
cls
echo =============================================
echo     Rxborn Tweaking Utility  –  CMD Edition
echo =============================================
echo [1] Create System Restore Point
echo [2] Clean Temp ^& Cache
echo [3] Disable Windows Animations
echo [4] Set High-Performance Power Plan
echo [5] Basic Network Tweaks  (flush DNS ^+ disable DoSvc)
echo [8] APPLY  ALL  TWEAKS
echo [9] REVERT ALL  TWEAKS
echo [0] EXIT
echo =============================================
set /p CHOICE=Choose (0-9): || set CHOICE=0
if "%CHOICE%"=="1" goto :RP
if "%CHOICE%"=="2" goto :TEMP
if "%CHOICE%"=="3" goto :ANIM
if "%CHOICE%"=="4" goto :POWER
if "%CHOICE%"=="5" goto :NET
if "%CHOICE%"=="8" goto :APPLYALL
if "%CHOICE%"=="9" goto :REVERTALL
if "%CHOICE%"=="0" exit /b 0
goto :MENU

::===========================================================================
:RP
echo Creating restore point...
wmic.exe /Namespace:\\root\default Path SystemRestore Call CreateRestorePoint "Rxborn Backup %TS%", 100, 7 >nul 2>nul && (
   %OK% & %LOG% Restore-point created
) || (
   echo [!] Could not create restore point (may be disabled). & %LOG% Restore-point failed
)
%PAUSE%
goto :MENU

::===========================================================================
:TEMP
echo Cleaning temp folders...
for %%D in (
   "%LOCALAPPDATA%\Temp"
   "%WINDIR%\Temp"
   "%LOCALAPPDATA%\D3DSCache"
   "%LOCALAPPDATA%\NVIDIA Corporation\NV_Cache"
) do (
   if exist "%%~D" (
      robocopy "%%~D" "%BAK%\empty" /MIR >nul 2>nul
      rd /s /q "%%~D" 2>nul
      md "%%~D" 2>nul
      %LOG% Cleaned %%~D
   )
)
%OK% & %LOG% Temp-clean finished
%PAUSE%
goto :MENU

::===========================================================================
:ANIM
echo Disabling Windows animations...
:: backup current value
for /f "tokens=3" %%V in ('reg query "HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\VisualEffects" /v VisualFXSetting 2^>nul') do set "VFX=%%V"
if defined VFX (echo %VFX%>"%BAK%\VisFXSetting.txt" & %LOG% Backed-up VisFX=%VFX%)
:: set to 2 = best performance
reg add "HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\VisualEffects" /v VisualFXSetting /t REG_DWORD /d 2 /f >nul
:: notify shell
rundll32 user32.dll,UpdatePerUserSystemParameters 1,True 2>nul
%OK% & %LOG% Animations disabled
%PAUSE%
goto :MENU

::===========================================================================
:POWER
echo Setting High-Performance power plan...
:: backup current
for /f "tokens=4" %%G in ('powercfg /getactivescheme') do set "OLDGUID=%%G"
if defined OLDGUID (echo %OLDGUID%>"%BAK%\power-guid.txt" & %LOG% Backed-up power GUID=%OLDGUID%)
:: look for built-in “High performance”
for /f "tokens=4" %%H in ('powercfg /list ^| find /i "High performance"') do set "HPG=%%H"
if defined HPG (
   powercfg /setactive %HPG% & %OK% & %LOG% Activated built-in High-performance
) else (
   :: duplicate current and tweak
   for /f "tokens=4" %%N in ('powercfg /duplicatescheme %OLDGUID%') do set "NG=%%N"
   powercfg /setacvalueindex %NG% SUB_PROCESSOR PROCTHROTTLEMAX 100 >nul
   powercfg /setdcvalueindex %NG% SUB_PROCESSOR PROCTHROTTLEMAX 100 >nul
   powercfg /setactive %NG% & %OK% & %LOG% Created/activated custom High-performance
)
%PAUSE%
goto :MENU

::===========================================================================
:NET
echo Flushing DNS...
ipconfig /flushdns | find /v "Resolver" & %LOG% DNS flushed
echo Stopping/Delivery Optimisation service...
sc stop DoSvc >nul 2>n1
sc config DoSvc start= disabled >nul 2>nul && (
   %OK% & %LOG% DoSvc disabled
) || (
   echo [!] Could not disable DoSvc & %LOG% DoSvc disable failed
)
%PAUSE%
goto :MENU

::===========================================================================
:APPLYALL
echo.
echo === Applying ALL tweaks ===
%LOG% Apply-All started
call :RP
call :TEMP
call :ANIM
call :POWER
call :NET
echo.
echo === All tweaks applied === & %LOG% Apply-All finished
%PAUSE%
goto :MENU

::===========================================================================
:REVERTALL
echo.
echo === Reverting ALL tweaks ===
%LOG% Revert-All started
:: restore registry files (exported keys)
for %%F in ("%BAK%\*_*.reg") do (
   echo Importing %%~nxF ...
   reg import "%%F" >nul 2>nul && %LOG% Imported %%~nxF
)
:: restore VisFX value if backed up
if exist "%BAK%\VisFXSetting.txt" (
   set /p VFX=<"%BAK%\VisFXSetting.txt"
   reg add "HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\VisualEffects" /v VisualFXSetting /t REG_DWORD /d !VFX! /f >nul
   %LOG% Restored VisFX=!VFX!
)
:: restore power plan
if exist "%BAK%\power-guid.txt" (
   set /p PG=<"%BAK%\power-guid.txt"
   powercfg /setactive !PG! && %LOG% Restored power-plan !PG!
)
:: re-enable DoSvc
sc config DoSvc start= auto >nul
sc start DoSvc >nul && %LOG% Re-enabled DoSvc
echo.
echo === Revert finished === & %LOG% Revert-All finished
%PAUSE%
goto :MENU
::===========================================================================
    Write-Host "`nFATAL ERROR: $_" -ForegroundColor Red
}
Read-Host "`nPress ENTER to close this window"
