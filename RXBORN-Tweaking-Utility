<#
.SYNOPSIS
  Rxborn Tweaking Utility - Safe, reversible 0 Delay tweaks for Windows.

.DESCRIPTION
  Implements safe tweaks to reduce input delay, stabilize frame delivery,
  reduce system load, and clean junk files. Includes:
    - System Restore Point creation
    - Backup of registry & file changes
    - Individually-selectable tweaks
    - Apply All & Revert All options
    - Logs actions & displays "✔️ Tweak Finished"

.NOTES
  - Run as Administrator.
  - Some tweaks may require a reboot.
#>

#region Helper & Environment Setup
# Ensure running as admin
function Ensure-Admin {
    $isAdmin = ([Security.Principal.WindowsPrincipal] [Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole] "Administrator")
    if (-not $isAdmin) {
        Write-Error "This script must be run as Administrator."
        exit 1
    }
}
Ensure-Admin

# Backup/log folder
$scriptRoot = Split-Path -Parent $MyInvocation.MyCommand.Path
$timestamp = (Get-Date).ToString("yyyyMMdd-HHmmss")
$backupRoot = Join-Path -Path $scriptRoot -ChildPath "ZeroDelayBackup-$timestamp"
New-Item -Path $backupRoot -ItemType Directory -Force | Out-Null
$logFile = Join-Path $backupRoot "tweak-log.txt"

function Log($msg) {
    "$((Get-Date).ToString('yyyy-MM-dd HH:mm:ss')) - $msg" | Tee-Object -FilePath $logFile -Append
}

function Notify-Finished($name) {
    Write-Host "✔️ $name - Tweak Finished"
    Log "$name finished."
}
#endregion

#region Restore Point & Restore Helpers
function Create-RestorePoint {
    try {
        if (Get-Command Checkpoint-Computer -ErrorAction SilentlyContinue) {
            $desc = "Rxborn Tweaking Utility Backup - $timestamp"
            Log "Creating restore point: $desc"
            Checkpoint-Computer -Description $desc -RestorePointType "APPLICATION" -ErrorAction Stop
            Notify-Finished "Create Restore Point"
            return $true
        } else {
            Log "Checkpoint-Computer not available."
            Write-Warning "System Restore API not available on this edition."
            return $false
        }
    } catch {
        Log "Restore Point creation failed: $_"
        Write-Warning "Restore Point failed. See log."
        return $false
    }
}
$restorePlanFile = Join-Path $backupRoot "restore-plan.json"
$restorePlan = [ordered]@{
    timestamp = $timestamp
    restorePointCreated = $false
    backups = @()
}
#endregion

#region Registry Backup Helper
function Backup-RegistryKey($keyPath, $friendlyName) {
    try {
        $safeName = ($friendlyName -replace '[^A-Za-z0-9\-_.]', '_')
        $outFile = Join-Path $backupRoot "$safeName-reg-$(Get-Date -Format yyyyMMdd-HHmmss).reg"
        Log "Exporting registry key $keyPath -> $outFile"
        reg export "$keyPath" "$outFile" /y | Out-Null
        $restorePlan.backups += @{ type="registry"; path=$keyPath; file=$outFile }
        return $outFile
    } catch {
        Log "Registry export failed for $keyPath : $_"
        return $null
    }
}
#endregion

#region Tweak Functions

# Temp & Cache Cleanup
function TempCache-0Delay { ... } # Keep previous Clear-TempFiles logic

# Windows Animations
function WindowsAnimations-0Delay { Disable-WindowsAnimations }

# High Performance Power Plan
function PowerPlan-0Delay { Set-HighPerformancePowerPlan }

# Network Optimizations
function Network-0Delay { Optimize-NetworkBasic }

# Keyboard Optimization
function Keyboard-0Delay { ... } # Keyboard tweaks as above

# Mouse Optimization
function Mouse-0Delay { ... } # Mouse tweaks as above

# Controller Optimization
function Controller-0Delay { ... } # Controller tweaks as above

# Manage Startup Apps
function Manage-StartupItems { ... } # Keep existing logic

# Set Process Priority
function Set-GameProcessPriority { ... } # Keep existing logic

#endregion

#region Apply All & Revert All
function Apply-AllTweaks {
    $tweaks = @(
        TempCache-0Delay,
        WindowsAnimations-0Delay,
        PowerPlan-0Delay,
        Network-0Delay,
        Keyboard-0Delay,
        Mouse-0Delay,
        Controller-0Delay
    )
    foreach ($tweak in $tweaks) { & $tweak }
}

function Revert-AllTweaks {
    # Implement revert logic using $restorePlan backups
    Write-Host "Reverting all tweaks..."
    Log "Reverting all tweaks..."
    foreach ($b in $restorePlan.backups) {
        switch ($b.type) {
            "registry" { reg import $b.file | Out-Null }
            "files" { Move-Item -Path $b.backup -Destination $b.original -Force }
            "powerplan" { powercfg /setactive $b.guid | Out-Null }
            "service" { Set-Service -Name $b.name -StartupType Automatic; Start-Service $b.name }
        }
    }
    Notify-Finished "Revert All Tweaks"
}
#endregion

#region Interactive Menu
function Show-Menu {
    Clear-Host
    Write-Host "============================================="
    Write-Host "    ⭐ Rxborn Tweaking Utility - 0 Delay ⭐"
    Write-Host "============================================="
    Write-Host "[1] Create Restore Point"
    Write-Host "[2] Temp & Cache Cleanup - 0 Delay"
    Write-Host "[3] Disable Windows Animations - 0 Delay"
    Write-Host "[4] High Performance Power Plan - 0 Delay"
    Write-Host "[5] Basic Network Optimizations - 0 Delay"
    Write-Host "[6] Keyboard Optimization - 0 Delay"
    Write-Host "[7] Mouse Optimization - 0 Delay"
    Write-Host "[8] Controller Optimization - 0 Delay"
    Write-Host "[9] Manage Startup Apps (interactive)"
    Write-Host "[10] Set Process Priority (interactive)"
    Write-Host "[11] Apply All Tweaks - 0 Delay"
    Write-Host "[12] Revert All Tweaks"
    Write-Host "[0] Exit"
    Write-Host "---------------------------------------------"
    $choice = Read-Host "Choose an option (0-12)"
    switch ($choice) {
        "1" { $restorePlan.restorePointCreated = Create-RestorePoint; Pause }
        "2" { TempCache-0Delay; Pause }
        "3" { WindowsAnimations-0Delay; Pause }
        "4" { PowerPlan-0Delay; Pause }
        "5" { Network-0Delay; Pause }
        "6" { Keyboard-0Delay; Pause }
        "7" { Mouse-0Delay; Pause }
        "8" { Controller-0Delay; Pause }
        "9" { Manage-StartupItems; Pause }
        "10" { Set-GameProcessPriority; Pause }
        "11" { Apply-AllTweaks; Pause }
        "12" { Revert-AllTweaks; Pause }
        "0" { Write-Host "Exiting..."; exit 0 }
        default { Write-Host "Invalid choice"; Pause }
    }
}

function Pause { Write-Host ""; Read-Host "Press Enter to continue..." }
#endregion

# Save initial metadata
$restorePlan | ConvertTo-Json -Depth 10 | Out-File -FilePath $restorePlanFile -Encoding UTF8

# Main loop
while ($true) { Show-Menu }
